{
  "name": "dsh-inbox-sidebar",
  "version": "0.6.0",
  "private": true,
  "description": "使用 DSH 原生控件的会话收件箱侧边栏。",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm test",
    "preview:build": "node scripts/build-native-preview.mjs",
    "verify:browser": "node scripts/verify-native-sidebar.mjs",
    "verify:interactions": "node scripts/verify-native-sidebar.mjs",
    "verify:t3-drag": "node scripts/verify-t3-port-drag.mjs",
    "t3:import": "node scripts/import-t3-sidebar.mjs",
    "verify:tooltips": "node scripts/verify-native-sidebar.mjs",
    "verify:settings": "node scripts/verify-native-sidebar.mjs",
    "verify:native": "node scripts/verify-native-sidebar.mjs",
    "verify:footer": "node scripts/verify-footer-icons.mjs",
    "verify:details": "node scripts/verify-session-details.mjs",
    "verify:header": "node scripts/verify-compact-header.mjs",
    "verify:settled-browser": "node scripts/verify-settled-browser.mjs",
    "package": "node scripts/package.mjs",
    "verify:projects": "node scripts/verify-project-groups.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.25.12",
    "lucide-react": "0.564.0",
    "playwright-core": "1.56.1",
    "postcss": "8.5.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
